{
  "name": "retardos-el-boom",
  "version": "1.0.0",
  "description": "Control de asistencia y retardos a partir de marcajes biométricos (BioTime/ZKTeco) para las sucursales de El Boom Tractopartes",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test test/",
    "build:css": "tailwindcss -i src/ui.css -o public/app.css --minify",
    "dev:css": "tailwindcss -i src/ui.css -o public/app.css --watch"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jszip": "^3.10.2",
    "mysql2": "^3.14.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
